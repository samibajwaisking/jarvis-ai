# Copy this file to ".env" and fill in what you need. Never commit your real .env file!

# --- Choose ONE AI engine -------------------------------------------------
# ollama    = 100% free, runs on your own computer (no key needed)
# anthropic = Claude (bring your own API key)
# openai    = GPT models (bring your own API key)
# gemini    = Google Gemini (bring your own API key)
JARVIS_PROVIDER=ollama

# Optional: override the default model for the provider you picked
# JARVIS_MODEL=llama3.1

# --- API keys (only for the provider you chose) ---------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Ollama (free local models) -------------------------------------------
OLLAMA_HOST=http://localhost:11434

# --- Behaviour ------------------------------------------------------------
JARVIS_MAX_TOKENS=1024
JARVIS_TEMPERATURE=0.7
JARVIS_HISTORY_LIMIT=20
JARVIS_TIMEOUT=60
# JARVIS_SYSTEM_PROMPT=You are Jarvis, ...
# JARVIS_HOME=~/.jarvis

# --- Web server -----------------------------------------------------------
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
# If you expose Jarvis to the internet, ALWAYS set a token:
# JARVIS_API_TOKEN=change-me-to-a-long-random-string

# --- Voice ----------------------------------------------------------------
JARVIS_VOICE_LANGUAGE=en-US
